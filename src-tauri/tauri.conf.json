{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caidan",
  "version": "0.1.0",
  "identifier": "xyz.songlim.caidan",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Caidan",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "resources": {
      "resources/config.yaml.sample": "config.yaml.sample"
    },
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "fragmentPaths": [
          "windows/fragments/images-dir.wxs"
        ],
        "componentRefs": [
          "ImagesFolderComponent"
        ]
      }
    }
  }
}